---
---
<div id="loading-screen" class="fixed inset-0 z-[100] bg-bg flex flex-col items-center justify-center transition-opacity duration-700">
  <div class="absolute top-0 left-0 w-full h-1 bg-surface">
    <div id="loading-progress" class="h-full bg-accent w-0 transition-all duration-[1.5s] ease-out"></div>
  </div>
  
  <div class="flex items-center gap-2 overflow-hidden">
    <span class="text-3xl font-bold tracking-tight text-text translate-y-full opacity-0" id="loading-text">Tencio</span>
    <span class="w-3 h-3 rounded-full bg-accent scale-0" id="loading-dot"></span>
  </div>
</div>

<script>
  import gsap from 'gsap';

  const initLoader = () => {
    const hasLoaded = sessionStorage.getItem('tencio-loaded');
    const screen = document.getElementById('loading-screen');
    
    if (hasLoaded) {
      screen?.remove();
      return;
    }

    // Lock scroll
    document.body.style.overflow = 'hidden';

    const tl = gsap.timeline({
      onComplete: () => {
        sessionStorage.setItem('tencio-loaded', 'true');
        document.body.style.overflow = '';
        if (screen) {
          screen.style.opacity = '0';
          setTimeout(() => screen.remove(), 700);
        }
      }
    });

    tl.to('#loading-progress', { width: '100%', duration: 1.5, ease: "power3.inOut" })
      .to('#loading-text', { y: 0, opacity: 1, duration: 0.6, ease: "back.out(1.7)" }, "-=1.0")
      .to('#loading-dot', { scale: 1, duration: 0.4, ease: "back.out(2)" }, "-=0.6")
      .to({}, { duration: 0.2 }); // Hold for a split second
  };

  // Run immediately on client
  initLoader();
</script>