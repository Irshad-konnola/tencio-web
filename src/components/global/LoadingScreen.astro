          <circle id="loading-brand-dot" fill="var(--color-accent)" cx="88" cy="14" r="9.5" class="origin-[88px_14px] scale-0" />
        </g>
      </svg>
    </div>

    <!-- Wordmark & Tagline -->
    <div class="flex items-center gap-2 overflow-hidden">
      <span class="text-2xl font-bold tracking-tight text-text translate-y-full opacity-0" id="loading-text">Tencio</span>
      <span class="text-xs font-mono text-muted uppercase tracking-widest translate-y-full opacity-0" id="loading-tag">Agency</span>
    </div>
  </div>
</div>

<script>
  import gsap from 'gsap';

  const initLoader = () => {
    const hasLoaded = sessionStorage.getItem('tencio-loaded');
    const screen = document.getElementById('loading-screen');
    
    if (hasLoaded) {
      screen?.remove();
      return;
    }

    // Lock scroll
    document.body.style.overflow = 'hidden';

    const tl = gsap.timeline({
      onComplete: () => {
        sessionStorage.setItem('tencio-loaded', 'true');
        document.body.style.overflow = '';
        if (screen) {
          screen.style.opacity = '0';
          setTimeout(() => screen.remove(), 700);
        }
      }
    });

    tl.to('#loading-progress', { width: '100%', duration: 1.4, ease: "power3.inOut" })
      .to('#loading-brand-icon', { opacity: 1, scale: 1, duration: 0.5, ease: "back.out(1.8)" }, "-=1.3")
      .to('#loading-brand-dot', { scale: 1, duration: 0.4, ease: "back.out(2.5)" }, "-=0.9")
      .to('#loading-text', { y: 0, opacity: 1, duration: 0.5, ease: "power2.out" }, "-=0.7")
      .to('#loading-tag', { y: 0, opacity: 0.7, duration: 0.4, ease: "power2.out" }, "-=0.5")
      .to({}, { duration: 0.2 }); // Hold for a split second
  };

  // Run immediately on client
  initLoader();
</script>