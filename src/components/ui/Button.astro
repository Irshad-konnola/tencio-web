---
interface Props {
  variant?: 'primary' | 'ghost' | 'outline';
  class?: string;
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  id?: string;
}

const { variant = 'primary', class: className = '', href, type = 'button', id } = Astro.props;

const baseStyles = "inline-flex items-center justify-center rounded-[4px] text-[14px] font-medium transition-all duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent disabled:opacity-50 disabled:pointer-events-none cursor-pointer";

const variants = {
  primary: "bg-accent text-accent-fg hover:scale-[1.02] active:scale-[0.98] h-11 px-6",
  ghost: "text-muted hover:text-text hover:bg-surface h-11 px-6",
  outline: "border border-border text-text hover:border-accent hover:text-text bg-transparent h-11 px-6"
};

const Tag = href ? 'a' : 'button';
---

<Tag
  id={id}
  href={href}
  type={href ? undefined : type}
  class:list={[baseStyles, variants[variant], className]}
>
  <slot />
</Tag>
