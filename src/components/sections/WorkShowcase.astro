---
import projects from '../../content/projects.json';
---
<section id="work" class="py-32 bg-surface/30 scroll-mt-16 overflow-hidden">
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center mb-16 work-header">
      <h2 class="text-h2 font-bold text-text mb-4">Selected Work</h2>
      <p class="text-muted text-lg max-w-2xl mx-auto">A glimpse into our recent digital projects.</p>
    </div>
    
    <div class="flex flex-wrap justify-center gap-8 work-grid">
      {projects.map((project) => {
        const Element = project.url ? 'a' : 'div';
        
        return (
          <Element 
            href={project.url} 
            target={project.url ? "_blank" : undefined}
            rel={project.url ? "noopener noreferrer" : undefined}
            class="project-card w-full sm:w-[calc(50%-1rem)] lg:w-[calc(33.333%-1.5rem)] max-w-[500px] flex-none group cursor-pointer block focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded-2xl select-none [-webkit-tap-highlight-color:transparent]"
            aria-label={project.url ? `Visit ${project.title} live website` : undefined}
          >
            {/* FIX: Added transform-gpu to the wrapper to create a dedicated rendering layer */}
            <div class="relative overflow-hidden rounded-2xl mb-6 aspect-4/3 bg-bg border border-border shadow-sm transform-gpu">
              <img 
                src={project.image} 
                alt={`Screenshot of ${project.title}`} 
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 transform-gpu will-change-transform"
                loading="lazy"
                decoding="async"
              />
              
              <div class="absolute inset-0 bg-bg/0 group-hover:bg-bg/20 transition-colors duration-500 flex items-center justify-center pointer-events-none">
                {project.url && (
                  <div class="translate-y-4 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-300 bg-accent text-accent-fg p-3 rounded-full shadow-lg transform-gpu will-change-[transform,opacity]">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M7 7h10v10"/><path d="M7 17 17 7"/>
                    </svg>
                  </div>
                )}
              </div>
            </div>
            
            <div class="px-2">
              <div class="text-xs font-mono text-accent mb-2 uppercase tracking-wider">{project.category}</div>
              <h3 class="text-xl font-bold text-text mb-2 group-hover:text-accent transition-colors flex items-center gap-2">
                {project.title}
              </h3>
              <p class="text-muted text-sm leading-relaxed">{project.desc}</p>
            </div>
          </Element>
        );
      })}
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  
  gsap.registerPlugin(ScrollTrigger);
  
  ScrollTrigger.config({ 
    ignoreMobileResize: true 
  });
  
  let mm = gsap.matchMedia();
  
  mm.add("(prefers-reduced-motion: no-preference)", () => {
    gsap.fromTo('.work-header', 
      { y: 30, opacity: 0 },
      {
        scrollTrigger: {
          trigger: '.work-header',
          start: "top 85%",
          toggleActions: "play none none none"
        },
        y: 0,
        opacity: 1,
        duration: 0.6,
        ease: "power2.out"
      }
    );

    gsap.fromTo('.project-card', 
      { y: 40, opacity: 0 },
      {
        scrollTrigger: {
          trigger: '.work-grid',
          start: "top 80%",
          toggleActions: "play none none none"
        },
        y: 0,
        opacity: 1,
        duration: 0.7,
        stagger: 0.15,
        ease: "power2.out"
      }
    );
  });
</script>