---
import projects from '../../content/projects.json';
---
<section id="work" class="py-32 bg-surface/30 scroll-mt-16 overflow-hidden">
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center mb-16 work-header">
      <h2 class="text-h2 font-bold text-text mb-4">Selected Work</h2>
      <p class="text-muted text-lg max-w-2xl mx-auto">
        Production SaaS platforms, AI web applications, and digital brand experiences engineered for real-world impact.
      </p>
    </div>
    
    <div class="flex flex-wrap justify-center gap-8 work-grid">
      {projects.map((project, index) => (
        <div class="project-card w-full sm:w-[calc(50%-1rem)] lg:w-[calc(33.333%-1.5rem)] max-w-[500px] flex-none group rounded-2xl flex flex-col justify-between bg-surface/40 border border-border/60 p-4 hover:border-accent/40 transition-all duration-300">
          
          <div>
            <!-- Universal Studio Mockup Stage (Never crops wide or tall screenshots) -->
            <button
              type="button"
              data-modal-open={`project-modal-${index}`}
              aria-label={`View ${project.title} case study`}
              class="relative block w-full text-left overflow-hidden rounded-xl mb-5 aspect-16/10 bg-bg border border-border shadow-sm cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
            >
              <!-- Ambient Blurred Backdrop (Fills any aspect ratio mismatch seamlessly) -->
              <img 
                src={project.image} 
                alt="" 
                aria-hidden="true"
                class="absolute inset-0 w-full h-full object-cover blur-2xl scale-125 opacity-30 pointer-events-none select-none"
                loading="lazy"
                onerror="this.style.display='none'"
              />

              <!-- Fallback state if image file isn't added yet -->
              <div class="image-fallback hidden absolute inset-0 flex-col items-center justify-center p-6 text-center bg-surface/60">
                <span class="text-xs font-mono uppercase tracking-widest text-accent mb-1">{project.category}</span>
                <span class="text-lg font-bold text-text/80">{project.title}</span>
              </div>

              <!-- Crisp Full Screenshot (Zero cropping of text or logos) -->
              <div class="relative z-10 w-full h-full p-2.5 sm:p-3 flex items-center justify-center">
                <img 
                  src={project.image} 
                  alt={`Screenshot of ${project.title}`} 
                  class="max-w-full max-h-full w-auto h-auto object-contain rounded-lg shadow-md transition-transform duration-500 md:group-hover:scale-[1.03]"
                  loading="lazy"
                  decoding="async"
                  onerror="this.style.display='none'; this.parentElement.previousElementSibling.classList.remove('hidden'); this.parentElement.previousElementSibling.classList.add('flex');"
                />
              </div>

              <!-- Hover Pill -->
              <div class="absolute inset-0 z-20 bg-black/0 group-hover:bg-black/25 transition-colors duration-300 flex items-end justify-end p-3">
                <span class="opacity-0 group-hover:opacity-100 translate-y-1 group-hover:translate-y-0 transition-all duration-300 text-xs font-medium bg-bg/95 text-text backdrop-blur-md px-3.5 py-1.5 rounded-full border border-border shadow-lg">
                  View Case Study ↗
                </span>
              </div>
            </button>
            
            <div class="px-1">
              <div class="text-xs font-mono text-accent mb-1.5 uppercase tracking-wider">{project.category}</div>
              
              <div class="flex items-start justify-between gap-4 mb-2">
                <h3 class="text-xl font-bold text-text pt-0.5">
                  <button
                    type="button"
                    data-modal-open={`project-modal-${index}`}
                    class="text-left hover:text-accent transition-colors cursor-pointer focus-visible:outline-none"
                  >
                    {project.title}
                  </button>
                </h3>
                
                {project.url ? (
                  <a 
                    href={project.url} 
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`Visit ${project.title} live website`}
                    title="Visit Live Website"
                    class="shrink-0 p-2 rounded-full bg-surface border border-border text-text hover:bg-accent hover:text-accent-fg hover:border-accent transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M7 7h10v10"/><path d="M7 17 17 7"/>
                    </svg>
                  </a>
                ) : (
                  <button
                    type="button"
                    data-modal-open={`project-modal-${index}`}
                    aria-label={`Open ${project.title} details`}
                    title="View Case Study"
                    class="shrink-0 p-2 rounded-full bg-surface border border-border text-muted hover:text-text hover:border-accent transition-colors cursor-pointer"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/>
                    </svg>
                  </button>
                )}
              </div>

              <p class="text-muted text-sm leading-relaxed mb-4">{project.desc}</p>
            </div>
          </div>

          <!-- Bottom Tags & Case Study Trigger -->
          <div class="px-1 pt-3 border-t border-border/50 mt-auto">
            {project.tags && (
              <div class="flex flex-wrap gap-1.5 mb-3">
                {project.tags.slice(0, 3).map((tag: string) => (
                  <span class="text-[11px] font-mono px-2.5 py-0.5 rounded-md bg-bg border border-border text-muted">
                    {tag}
                  </span>
                ))}
                {project.tags.length > 3 && (
                  <span class="text-[11px] font-mono px-2 py-0.5 rounded-md bg-bg border border-border text-muted">
                    +{project.tags.length - 3}
                  </span>
                )}
              </div>
            )}

            <button
              type="button"
              data-modal-open={`project-modal-${index}`}
              class="inline-flex items-center gap-1.5 text-xs font-semibold text-accent hover:underline cursor-pointer py-1"
            >
              <span>View Case Study & Deliverables</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
              </svg>
            </button>
          </div>

          <!-- Full-Screen Case Study Modal (Lenis-compatible + Sticky Header/Footer + Outside Click Close) -->
          <dialog
            id={`project-modal-${index}`}
            data-lenis-prevent
            class="project-dialog fixed inset-0 z-50 m-0 h-dvh w-screen max-w-none max-h-none bg-transparent border-0 p-0 overflow-hidden backdrop:bg-transparent"
          >
            <!-- Full-Screen Wrapper -->
            <div class="relative flex h-full w-full items-center justify-center p-3 sm:p-6">
              
              <!-- Clickable Dark Backdrop (Click anywhere outside the box to close) -->
              <div
                data-modal-close
                class="modal-backdrop absolute inset-0 bg-black/80 backdrop-blur-md cursor-pointer"
                aria-hidden="true"
              ></div>

              <!-- Modal Card Shell (Locked Flex Layout: Sticky Header + Scrollable Body + Sticky Footer) -->
              <div
                role="document"
                class="relative z-10 flex flex-col w-full max-w-2xl max-h-[88dvh] rounded-2xl bg-bg text-text border border-border shadow-2xl overflow-hidden"
              >
                <!-- 1. STICKY TOP HEADER (Always visible while scrolling) -->
                <div class="shrink-0 flex items-center justify-between gap-4 px-5 py-4 sm:px-7 sm:py-5 bg-bg/95 backdrop-blur-md border-b border-border z-20">
                  <div class="min-w-0">
                    <div class="text-[11px] font-mono text-accent uppercase tracking-wider truncate">
                      {project.category} {project.client ? `• ${project.client}` : ''}
                    </div>
                    <h3 class="text-xl sm:text-2xl font-bold text-text truncate">{project.title}</h3>
                  </div>

                  <button
                    type="button"
                    data-modal-close
                    aria-label="Close case study modal"
                    class="shrink-0 inline-flex items-center gap-1.5 px-3 py-2 rounded-full bg-surface border border-border text-muted hover:text-text hover:border-accent transition-colors cursor-pointer"
                  >
                    <span class="text-xs font-mono hidden sm:inline">ESC</span>
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
                    </svg>
                  </button>
                </div>

                <!-- 2. SCROLLABLE BODY (Mouse wheel & touchpad enabled via data-lenis-prevent) -->
                <div
                  data-lenis-prevent
                  data-lenis-prevent-wheel
                  data-lenis-prevent-touch
                  class="modal-scroll-body flex-1 overflow-y-auto overscroll-contain px-5 py-6 sm:px-7 space-y-6"
                >
                  <!-- Uncropped Studio Image Showcase -->
                  <div class="relative overflow-hidden rounded-xl border border-border bg-surface/60 aspect-16/10 flex items-center justify-center p-3">
                    <img
                      src={project.image}
                      alt=""
                      aria-hidden="true"
                      class="absolute inset-0 w-full h-full object-cover blur-2xl scale-125 opacity-25 pointer-events-none"
                      onerror="this.style.display='none'"
                    />
                    <img
                      src={project.image}
                      alt={project.title}
                      class="relative z-10 max-w-full max-h-full w-auto h-auto object-contain rounded-lg shadow-lg"
                      loading="lazy"
                      onerror="this.parentElement.style.display='none'"
                    />
                  </div>

                  <!-- Optional Extra Gallery Spreads (e.g., Sol & Tree Brochure Pages) -->
                  {project.gallery && project.gallery.length > 0 && (
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                      {project.gallery.map((imgUrl: string, i: number) => (
                        <div class="overflow-hidden rounded-xl border border-border bg-surface/60 aspect-16/10 p-2 flex items-center justify-center">
                          <img
                            src={imgUrl}
                            alt={`${project.title} view ${i + 1}`}
                            class="max-w-full max-h-full object-contain rounded-md"
                            loading="lazy"
                            onerror="this.parentElement.style.display='none'"
                          />
                        </div>
                      ))}
                    </div>
                  )}

                  <!-- The Challenge -->
                  {project.challenge && (
                    <div>
                      <h4 class="text-xs font-mono uppercase tracking-wider text-accent mb-2">The Challenge</h4>
                      <p class="text-sm text-text/90 leading-relaxed bg-surface/50 border border-border rounded-xl p-4">
                        {project.challenge}
                      </p>
                    </div>
                  )}

                  <!-- What We Engineered & Delivered -->
                  {project.deliverables && (
                    <div>
                      <h4 class="text-xs font-mono uppercase tracking-wider text-accent mb-3">What We Engineered & Delivered</h4>
                      <ul class="space-y-2.5">
                        {project.deliverables.map((item: string) => (
                          <li class="flex items-start gap-2.5 text-sm text-muted leading-relaxed">
                            <span class="text-accent mt-0.5 shrink-0">✦</span>
                            <span>{item}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}

                  <!-- Full Tech Stack & Capabilities -->
                  {project.tags && (
                    <div>
                      <h4 class="text-xs font-mono uppercase tracking-wider text-accent mb-2.5">Technologies & Capabilities</h4>
                      <div class="flex flex-wrap gap-2">
                        {project.tags.map((tag: string) => (
                          <span class="text-xs font-mono px-3 py-1 rounded-full bg-surface border border-border text-text">
                            {tag}
                          </span>
                        ))}
                      </div>
                    </div>
                  )}
                </div>

                <!-- 3. STICKY BOTTOM FOOTER (Always accessible without scrolling) -->
                <div class="shrink-0 flex flex-wrap items-center justify-between gap-3 px-5 py-4 sm:px-7 bg-bg/95 backdrop-blur-md border-t border-border z-20">
                  {project.url ? (
                    <a
                      href={project.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-accent text-accent-fg text-xs sm:text-sm font-semibold hover:opacity-90 transition-opacity"
                    >
                      <span>Visit Live Project</span>
                      <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M7 7h10v10"/><path d="M7 17 17 7"/>
                      </svg>
                    </a>
                  ) : (
                    <span class="text-xs font-mono text-muted bg-surface border border-border px-3.5 py-2 rounded-full">
                      {project.statusNote || "Client Production System"}
                    </span>
                  )}

                  <div class="flex items-center gap-4 ml-auto">
                    <a
                      href="#start"
                      data-modal-close
                      class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-semibold text-text hover:text-accent transition-colors"
                    >
                      <span>Build something similar?</span>
                      <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
                      </svg>
                    </a>
                  </div>
                </div>

              </div>
            </div>
          </dialog>

        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* Custom sleek dark scrollbar for the Case Study Modal */
  .modal-scroll-body {
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.2) transparent;
  }

  .modal-scroll-body::-webkit-scrollbar {
    width: 6px;
  }

  .modal-scroll-body::-webkit-scrollbar-track {
    background: transparent;
  }

  .modal-scroll-body::-webkit-scrollbar-thumb {
    background-color: rgba(255, 255, 255, 0.18);
    border-radius: 9999px;
  }

  .modal-scroll-body::-webkit-scrollbar-thumb:hover {
    background-color: rgba(255, 255, 255, 0.35);
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  
  gsap.registerPlugin(ScrollTrigger);
  
  ScrollTrigger.config({ 
    ignoreMobileResize: true 
  });
  
  let mm = gsap.matchMedia();
  
  mm.add("(prefers-reduced-motion: no-preference)", () => {
    gsap.fromTo('.work-header', 
      { y: 30, opacity: 0 },
      {
        scrollTrigger: {
          trigger: '.work-header',
          start: "top 85%",
          toggleActions: "play none none none"
        },
        y: 0,
        opacity: 1,
        duration: 0.6,
        ease: "power2.out"
      }
    );

    gsap.fromTo('.project-card', 
      { y: 40, opacity: 0 },
      {
        scrollTrigger: {
          trigger: '.work-grid',
          start: "top 80%",
          toggleActions: "play none none none"
        },
        y: 0,
        opacity: 1,
        duration: 0.7,
        stagger: 0.15,
        ease: "power2.out"
      }
    );
  });

  // Case Study Modal Controller
  document.querySelectorAll('[data-modal-open]').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const modalId = trigger.getAttribute('data-modal-open');
      const dialog = modalId ? (document.getElementById(modalId) as HTMLDialogElement | null) : null;
      if (dialog) {
        dialog.showModal();
        document.documentElement.style.overflow = 'hidden';
        document.body.style.overflow = 'hidden';
      }
    });
  });

  document.querySelectorAll('.project-dialog').forEach((dialogEl) => {
    const dialog = dialogEl as HTMLDialogElement;

    // Close when clicking the backdrop OR any [data-modal-close] button
    dialog.querySelectorAll('[data-modal-close]').forEach((closeTrigger) => {
      closeTrigger.addEventListener('click', () => {
        dialog.close();
      });
    });

    // Restore page scrolling when modal closes (via button, outside backdrop click, or ESC key)
    dialog.addEventListener('close', () => {
      document.documentElement.style.overflow = '';
      document.body.style.overflow = '';
    });
  });
</script>