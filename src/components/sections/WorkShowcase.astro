---
import projects from '../../content/projects.json';
---
<section id="work" class="py-32 bg-surface/30 scroll-mt-16 overflow-hidden">
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center mb-16 work-header">
      <h2 class="text-h2 font-bold text-text mb-4">Selected Work</h2>
      <p class="text-muted text-lg max-w-2xl mx-auto">A glimpse into our recent digital projects.</p>
    </div>
    
    <div class="flex flex-wrap justify-center gap-8 work-grid">
      {projects.map((project) => (
        /* The entire card is now a standard DIV. It is completely safe to tap on mobile. */
        <div class="project-card w-full sm:w-[calc(50%-1rem)] lg:w-[calc(33.333%-1.5rem)] max-w-[500px] flex-none group rounded-2xl">
          
          <div class="relative overflow-hidden rounded-2xl mb-6 aspect-4/3 bg-bg border border-border shadow-sm">
            <img 
              src={project.image} 
              alt={`Screenshot of ${project.title}`} 
              class="w-full h-full object-cover transition-transform duration-700 md:group-hover:scale-105"
              loading="lazy"
              decoding="async"
            />
          </div>
          
          <div class="px-2">
            <div class="text-xs font-mono text-accent mb-2 uppercase tracking-wider">{project.category}</div>
            
            <div class="flex items-start justify-between gap-4 mb-2">
              <h3 class="text-xl font-bold text-text flex items-center gap-2 pt-1">
                {project.title}
              </h3>
              
              /* THIS IS THE EXPLICIT NAVIGATION BUTTON */
              {project.url && (
                <a 
                  href={project.url} 
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Visit ${project.title} live website`}
                  class="shrink-0 p-2.5 rounded-full bg-surface border border-border text-text hover:bg-accent hover:text-accent-fg hover:border-accent transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M7 7h10v10"/><path d="M7 17 17 7"/>
                  </svg>
                </a>
              )}
            </div>

            <p class="text-muted text-sm leading-relaxed">{project.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  
  gsap.registerPlugin(ScrollTrigger);
  
  ScrollTrigger.config({ 
    ignoreMobileResize: true 
  });
  
  let mm = gsap.matchMedia();
  
  mm.add("(prefers-reduced-motion: no-preference)", () => {
    gsap.fromTo('.work-header', 
      { y: 30, opacity: 0 },
      {
        scrollTrigger: {
          trigger: '.work-header',
          start: "top 85%",
          toggleActions: "play none none none"
        },
        y: 0,
        opacity: 1,
        duration: 0.6,
        ease: "power2.out"
      }
    );

    gsap.fromTo('.project-card', 
      { y: 40, opacity: 0 },
      {
        scrollTrigger: {
          trigger: '.work-grid',
          start: "top 80%",
          toggleActions: "play none none none"
        },
        y: 0,
        opacity: 1,
        duration: 0.7,
        stagger: 0.15,
        ease: "power2.out"
      }
    );
  });
</script>